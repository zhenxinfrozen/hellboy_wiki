# ===== 敏感：本地私有配置（含后台账户密码哈希，绝不入库）=====
/admin/config.local.php

# ===== 后台自动备份（本地产物，不入库）=====
/admin/backups/

# ===== 临时 / 锁 / 日志 =====
*.tmp
*.tmp-*
*.log
*.lock
*.bak
*.swp
*~

# ===== Python 缓存（tools/）=====
__pycache__/
*.pyc

# ===== 系统/编辑器垃圾 =====
.DS_Store
Thumbs.db
.idea/
.vscode/

# ===== 打包产物 =====
*.tar.gz
*.zip

# ===== 图片：content/images/ 根目录只留 webp（老格式本地备份在仓库外）=====
# thumb/ 与 gallery/ 子目录的派生 webp 仍入库
/content/images/*.jpg
/content/images/*.jpeg
/content/images/*.png
/content/images/*.gif
